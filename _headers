# Cloudflare Pages (ja Netlify) cache-päised.
/data/*
  Cache-Control: public, max-age=300

/index.html
  Cache-Control: public, max-age=60

/puramiid.html
  Cache-Control: public, max-age=60

/mangijad.html
  Cache-Control: public, max-age=60

# Fellin Racketsi avalehe ettepanek kliendile kommenteerimiseks —
# mitte Google'isse (päris leht tuleb fellinrackets.ee-sse).
/fellin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=60
